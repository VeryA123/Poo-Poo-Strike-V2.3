def atk_goal(a):
    b = G.bomb
    if b['planted']: return (b['pos'] if b['defuse'] > .3 else SPOTS[b['site']][a.idx % 5]), 'cover'
    s = G.oplan if (G.order == 'plant' and G.team == 'A') else G.plan
    carrier = a is G.carrier
    if a.idx == 4 and not carrier and not human(a):                 # lurker: cuts off rotations, joins late
        if G.exec_t is None or G.t - G.exec_t < 6: return LURK, 'hold'
