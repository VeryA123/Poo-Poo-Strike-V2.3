    st = STAGE[s]; off = ((a.idx % 3 - 1) * 1.4, ((a.idx // 3) % 2 - .5) * 1.6); stage = (st[0] + off[0], st[1] + off[1])
    if G.exec_t is None or G.t < G.exec_t + 1.5 + (2.5 if carrier else 0) + .4 * (a.idx % 4): return stage, 'stage'
    if carrier: return SITES[s], 'plant'
