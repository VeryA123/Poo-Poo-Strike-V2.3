    if a.vis_t <= 0:
        a.vis_t = .12; a.vis = [e for e in G.actors if e.alive and e.team != a.team and can_see(a, e)]
    if a.retreat > 0:                                   # hurt: fall back to cover and regroup
        a.retreat -= dt
        if not (a.vis and min(math.hypot(e.x - a.x, e.y - a.y) for e in a.vis) < 4):
            fb = STAGE[G.plan] if a.team == 'A' else HOLD[a.idx]; go(a, fb[0], fb[1], 3.8, dt); return
    if a.vis:
