def update_play(dt):
    G.t += dt; G.round_time -= dt; b = G.bomb
    atk = [a for a in G.actors if a.team == 'A' and a.alive]; dfn = [a for a in G.actors if a.team == 'D' and a.alive]
    G.carrier = G.pcar if (G.order == 'plant' and G.team == 'A' and G.pcar and G.pcar.alive) else (atk[0] if atk else None)
    if b['planted']:
        bots = [a for a in dfn if not human(a)]
        G.defuser = min(bots, key=lambda a: math.hypot(a.x - b['pos'][0], a.y - b['pos'][1])) if bots else None
    for a in G.actors:
        if a.alive:
            if human(a): player_update(a, dt)
            else: bot_update(a, dt)
    update_nades(dt); G.blind = max(0, G.blind - dt)
    sp_ = G.oplan if (G.order == 'plant' and G.team == 'A') else G.plan
    if not b['planted'] and G.exec_t is None:                       # attackers: stage, then execute together
        bots_a = [a for a in atk if not human(a)]
        ready = sum(1 for a in bots_a if math.hypot(a.x - STAGE[sp_][0], a.y - STAGE[sp_][1]) < 5)
        if elapsed() > 8 and (ready >= max(1, len(bots_a) - 1) or elapsed() > 26 or G.order in ('goa', 'gob', 'plant')):
            G.exec_t = G.t; team_util('A', sp_)
    elif b['planted'] and not G.rt_exec and G.rt0 is not None and (G.t - G.rt0 > 7 or b['timer'] < 16):
        G.rt_exec = True; team_util('D', b['site'])               # defenders: retake with utility
    if not b['planted']:
        if any(a.planting for a in atk): b['prog'] += dt
        else: b['prog'] = 0
        if b['prog'] >= PLANT_T:
            c = next(a for a in atk if a.planting)
            site = site_near(c.x, c.y); c.money = min(10000, c.money + 300)
            b.update(planted=True, site=site, pos=SITES[site], timer=BOMB_TIME, prog=0)
            G.msg = (f"POO POO PLANTED at the {SNAME[site]}!", 4); G.rt0 = G.t; G.rt_exec = False
    else:
        b['timer'] -= dt
        b['defuse'] = b['defuse'] + dt * (1.7 if any(a.defusing and a.plunger for a in dfn) else 1) if any(a.defusing for a in dfn) else 0
    if b['planted']:
        if b['timer'] <= 0: G.flash = 1; end_round('A', "The Poo Poo went off!")
        elif b['defuse'] >= DEFUSE_T: end_round('D', "Poo Poo flushed away!")
        elif not dfn: end_round('A', "All cleaners are down!")
    else:
        if not atk: end_round('D', "All stinkers are down!")
        elif not dfn: end_round('A', "All cleaners are down!")
        elif G.round_time <= 0: end_round('D', "Time ran out!")

