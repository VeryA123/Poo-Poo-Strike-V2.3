        if mode == 'defuse' and d < 1.5: a.defusing = True
        if mode == 'order': wx, wy = G.player.x + math.cos(G.player.ang) * 10, G.player.y + math.sin(G.player.ang) * 10
        else: wx, wy = (WATCH[G.bomb['site'] or G.plan] if a.team == 'A' else WATCH_D[a.idx])
