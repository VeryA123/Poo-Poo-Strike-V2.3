def human(a): return a is G.player and not SMOKE

def noise(x, y, team, r):
    for e in G.actors:
        if e.alive and e.team != team and not human(e) and math.hypot(e.x - x, e.y - y) < r:
            e.heard = (x, y, G.t); G.intel[e.team] = (x, y, G.t)

def hurt(att, vic, dmg):
    if vic.armor > 0: vic.armor = max(0, vic.armor - dmg * .5); dmg *= .6
    vic.hp -= dmg
    if not human(vic) and 0 < vic.hp < 50 and vic.retreat <= 0 and random.random() < .7 and sum(1 for x in G.actors if x.team == vic.team and x.alive) > 1: vic.retreat = 2.8
    if human(vic): G.dmg = .4; G.hitsrc = (att.x, att.y); G.hitt = 1.2
    if att is G.player: G.hit = .25
    if not human(vic):
        vic.heard = (att.x, att.y, G.t); G.intel[vic.team] = (att.x, att.y, G.t)
        if vic.target is None: vic.last_seen = (att.x, att.y, G.t)
    if vic.hp <= 0 and vic.alive:
        vic.alive, vic.prim, vic.armor, vic.w, vic.sec, vic.util, vic.held = False, None, 0, 0, 0, {}, None; vic.plunger = False
        att.money = min(10000, att.money + 300)
        G.feed.append([f"{att.name}  [{WEAPONS[att.w]['n']}]  {vic.name}", 5, ORANGE if att.team == 'A' else BLUE])

def fire(a, sigma):
    w = WEAPONS[a.w]
    if a.cd > 0: return
    if human(a):
        if a.reload_t > 0: return
        if a.ammo.get(a.w, 0) <= 0: start_reload(a); return
        a.ammo[a.w] -= 1
    a.cd = w['cd'] * (1 if human(a) else 1 + (w['bm'] - 1) / G.skill); a.flash = .08
    if human(a): a.recoil = min(1, a.recoil + w['rec'])
    noise(a.x, a.y, a.team, 16)
    for _ in range(w['pel']):
        ang = a.ang + random.gauss(0, sigma + w['spr'] * (1 - .5 * G.ads if human(a) else 1))
        dx, dy = math.cos(ang), math.sin(ang)
        ox, oy = a.x + a.lx, a.y + a.ly; dw = ray(ox, oy, dx, dy)[0]; best, bt = None, dw
        for e in G.actors:
            if e.alive and e.team != a.team:
                r = (.18 if G.jz > .12 else .25 if G.crouch > .5 else .3) if human(e) else .3
                rx, ry = e.x + e.lx - ox, e.y + e.ly - oy; t = rx * dx + ry * dy
                if 0 < t < bt and abs(rx * dy - ry * dx) < r: best, bt = e, t
        if best:
            mult = 1
            if human(a) and .5 + G.z - G.crouch * .18 + G.pitch * bt / (H * TANH / G.tanh) > .6: mult = 1.8; G.hs = .8
            hurt(a, best, w['dmg'] * mult * (1 if human(a) else .9 + .1 * G.skill))

