def solid(x, y):
    ix, iy = int(x), int(y)
    return not (0 <= ix < MW and 0 <= iy < MH) or grid[iy][ix] != 0
def free(x, y, r=.28): return not (solid(x - r, y - r) or solid(x + r, y - r) or solid(x - r, y + r) or solid(x + r, y + r))
def try_move(a, dx, dy):
    m = False
    if free(a.x + dx, a.y): a.x += dx; m = True
    if free(a.x, a.y + dy): a.y += dy; m = True
    return m

def ray(px, py, dx, dy):
    mx, my = int(px), int(py)
    ddx = abs(1 / dx) if dx else 1e30; ddy = abs(1 / dy) if dy else 1e30
    if dx < 0: sx, sdx = -1, (px - mx) * ddx
    else: sx, sdx = 1, (mx + 1 - px) * ddx
    if dy < 0: sy, sdy = -1, (py - my) * ddy
    else: sy, sdy = 1, (my + 1 - py) * ddy
    while True:
        if sdx < sdy: sdx += ddx; mx += sx; side = 0
        else: sdy += ddy; my += sy; side = 1
        if not (0 <= mx < MW and 0 <= my < MH):
            return (sdx - ddx if side == 0 else sdy - ddy), side, 1, min(max(mx, 0), MW - 1), min(max(my, 0), MH - 1)
        if grid[my][mx] and grid[my][mx] < 8: break
    return (sdx - ddx if side == 0 else sdy - ddy), side, grid[my][mx], mx, my

def ray2(px, py, dx, dy):
    mx, my = int(px), int(py)
    ddx = abs(1 / dx) if dx else 1e30; ddy = abs(1 / dy) if dy else 1e30
    if dx < 0: sx, sdx = -1, (px - mx) * ddx
    else: sx, sdx = 1, (mx + 1 - px) * ddx
    if dy < 0: sy, sdy = -1, (py - my) * ddy
    else: sy, sdy = 1, (my + 1 - py) * ddy
    lows = []
    while True:
        if sdx < sdy: sdx += ddx; mx += sx; side = 0; dist = sdx - ddx
        else: sdy += ddy; my += sy; side = 1; dist = sdy - ddy
        if lows and lows[-1][1] is None: lows[-1][1] = dist
        if not (0 <= mx < MW and 0 <= my < MH): return dist, side, 1, min(max(mx, 0), MW - 1), min(max(my, 0), MH - 1), lows
        v = grid[my][mx]
        if v >= 8: lows.append([dist, None, side, mx, my])
        elif v: return dist, side, v, mx, my, lows

def throw(a, kind, tx, ty, arc=1.4):
    d = math.hypot(tx - a.x, ty - a.y)
    G.nades.append(dict(x=a.x, y=a.y, ang=math.atan2(ty - a.y, tx - a.x), left=d, tot=max(d, .1), kind=kind, by=a, fuse=1.5, fly=True, arc=arc))

def nade_dist(p, power, roll):
    d = ((2 + power * 6) if roll else (3 + power * 11)) * (1 + G.pitch / 340 * .5)
    return max(1.2, min(d, max(1.2, ray(p.x, p.y, math.cos(p.ang), math.sin(p.ang))[0] - .5)))

def proj(p, x, y, z):
    tanh = G.tanh; SC = TANH / tanh; e = .5 + G.z - G.crouch * .18; hz = H // 2 + int(G.pitch)
    px, py = p.x + p.lx, p.y + p.ly; dx, dy = math.cos(p.ang), math.sin(p.ang); plx, ply = -dy * tanh, dx * tanh
    inv = 1.0 / (plx * dy - dx * ply); sx, sy = x - px, y - py; ty = inv * (-ply * sx + plx * sy)
    if ty < .2: return None
    return W / 2 * (1 + inv * (dy * sx - dx * sy) / ty), hz + (e - z) * H * SC / ty, ty

def draw_guide(p):
    if not (p.alive and p.held): return
    roll = G.roll; pw = max(p.charge, .3); d = nade_dist(p, pw, roll); c, sn = math.cos(p.ang), math.sin(p.ang); arc = 0 if roll else 1.6
    col = UTIL[p.held][2]
    def ok(q): return q and 0 <= q[0] < W and ZB[min(NR - 1, int(q[0] // RES))] > q[2] - .25
    for i in range(25):
        f = i / 24; q = proj(p, p.x + c * d * f, p.y + sn * d * f, .45 * (1 - f) + arc * 4 * f * (1 - f))
        if ok(q): circ(col, q[0], q[1], 3)
    lx, ly = p.x + c * d, p.y + sn * d
    for i in range(18):
        a = i / 18 * 2 * math.pi; q = proj(p, lx + math.cos(a) * .6, ly + math.sin(a) * .6, 0)
        if ok(q): circ((255, 255, 255), q[0], q[1], 2)
    rect((40, 40, 50), W // 2 - 90, H - 118, 180, 14, 4); rect((200, 200, 255) if roll else col, W // 2 - 90, H - 118, 180 * p.charge, 14, 4)
    txt("ROLL (low, short)" if roll else "LOB (high arc)", FS, (255, 255, 255), W // 2, H - 128, True)
    txt("hold click / G = power, aim with mouse + arrows, release = throw, hold X = roll", FS, (230, 230, 240), W // 2, H - 96, True)

