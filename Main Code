def buy(a, i):
    w = WEAPONS[i]; cur = a.sec if i in SECOND else a.prim
    if a.money >= w['cost'] and cur != i:
        a.money -= w['cost']; a.w = i; a.ammo[i] = MAG[i]; a.res[i] = MAG[i] * 3
        if i in SECOND: a.sec = i
        else: a.prim = i
def buy_plunger(a):
    if a.team == 'D' and a.money >= 400 and not a.plunger: a.money -= 400; a.plunger = True

def buy_util(a, k):
    if a.money >= UTIL[k][1] and a.util.get(k, 0) < 2: a.money -= UTIL[k][1]; a.util[k] = a.util.get(k, 0) + 1

def buy_armor(a):
    if a.money >= 650 and a.armor < 100: a.money -= 650; a.armor = 100
def bot_buy(a):
    if a.prim is None:
        opts = [i for i in (4, 7, 2, 3, 1) if WEAPONS[i]['cost'] <= a.money]
        if opts: buy(a, random.choice(opts[:3]))
    if a.sec == 0 and a.money >= 700 and random.random() < .5: buy(a, random.choice((5, 6)))
    buy_armor(a)
    for k in UTIL:
        if random.random() < .4: buy_util(a, k)
    if a.team == 'D' and a.money >= 400 and random.random() < .7: buy_plunger(a)
    a.w = a.prim if a.prim is not None else a.sec

def new_round():
    G.bomb = dict(planted=False, timer=BOMB_TIME, site=None, pos=None, prog=0, defuse=0)
    G.plan = random.choice('AB'); G.intel = {'A': None, 'D': None}; G.feed = []
    G.state, G.timer, G.round_time, G.flash, G.over = 'buy', BUY_TIME, ROUND_TIME, 0, False
    G.jz = G.vz = G.pitch = G.ads = G.z = G.pvx = G.pvy = G.blind = 0
    G.nades, G.smokes, G.fx, G.order, G.wheel = [], [], [], None, None
    G.exec_t = G.rt0 = None; G.rt_exec = False; G.lean = 0
    cnt = {'A': 0, 'D': 0}
    for a in G.actors:
        x, y = SPAWN[a.team][a.idx]; a.reset(x, y); a.ang = 0 if a.team == 'A' else math.pi
