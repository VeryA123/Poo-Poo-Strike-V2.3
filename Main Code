def main():
    if SMOKE: start_match('A'); G.state = 'buy'
    frames, ft = 0, []
    BUYKEYS = {pygame.K_1: 1, pygame.K_2: 2, pygame.K_3: 3, pygame.K_4: 4, pygame.K_5: 7, pygame.K_6: 5, pygame.K_7: 6}
    while True:
        raw = 1 / 30 if SMOKE else min(clock.tick(60) / 1000, .05); dt = raw * (.2 if G.wheel else 1); G.dt = dt
        for e in pygame.event.get():
            if e.type == pygame.QUIT: pygame.quit(); sys.exit()
            if e.type == pygame.KEYUP and G.wheel and e.key == (pygame.K_TAB if G.wheel == 'weapon' else pygame.K_z): close_wheel()
            if e.type != pygame.KEYDOWN: continue
            k = e.key
            if k == pygame.K_ESCAPE: pygame.quit(); sys.exit()
            if k == pygame.K_F1: set_res(4 if RES >= 8 else RES + 2)
            if k == pygame.K_F2: G.skill = {.9: 1.25, 1.25: 1.7, 1.7: .9}.get(G.skill, 1.25); G.msg = (f"Bot difficulty: {'EASY' if G.skill < 1 else 'NORMAL' if G.skill < 1.5 else 'HARD'}", 2.5)
            if G.state == 'title':
                if k in (pygame.K_1, pygame.K_2): start_match('A' if k == pygame.K_1 else 'D')
                continue
            p = G.player
            if G.state == 'buy':
                if k in BUYKEYS: buy(p, BUYKEYS[k])
                elif k == pygame.K_8: buy_armor(p)
                elif k == pygame.K_9: buy_util(p, 'slime')
                elif k == pygame.K_0: buy_util(p, 'bubble')
                elif k == pygame.K_g: buy_util(p, 'glitter')
                elif k == pygame.K_p: buy_plunger(p)
                elif k == pygame.K_RETURN: G.state = 'play'; pygame.mouse.get_rel()
            elif G.state == 'play' and p.alive:
                if k == pygame.K_1: equip(p, 'sec')
                elif k == pygame.K_2: equip(p, 'prim')
                elif k == pygame.K_3: equip(p, 'slime')
                elif k == pygame.K_4: equip(p, 'bubble')
                elif k == pygame.K_5: equip(p, 'glitter')
                elif k == pygame.K_r: start_reload(p)
                elif k == pygame.K_TAB: open_wheel('weapon')
                elif k == pygame.K_z: open_wheel('cmd')
            if G.state in ('play', 'end') and not p.alive:
                if k == pygame.K_RIGHT: G.vi += 1
                elif k == pygame.K_LEFT: G.vi -= 1
                elif k == pygame.K_v:
                    G.cammode = (G.cammode + 1) % 3; c = G.lastcam; G.free.x, G.free.y, G.free.ang = c.x, c.y, c.ang
            if G.state == 'over' and k == pygame.K_r: G.state = 'title'; pygame.mouse.set_visible(True); pygame.event.set_grab(False)
        if G.state == 'title': title(); pygame.display.flip(); continue
        if SMOKE and G.state == 'buy': G.state = 'play'
        p = G.player
        G.dmg = max(0, G.dmg - dt); G.hit = max(0, G.hit - dt); G.hs = max(0, G.hs - dt); G.hitt = max(0, G.hitt - dt); G.flash = max(0, G.flash - dt * .5)
        G.msg = (G.msg[0], G.msg[1] - dt); G.feed = [f for f in G.feed if (f.__setitem__(1, f[1] - dt) or f[1] > 0)]
        if G.state == 'buy':
            G.timer -= dt
            if G.timer <= 0: G.state = 'play'; pygame.mouse.get_rel()
            elif not SMOKE:
                mx, my = pygame.mouse.get_rel(); p.ang += mx * .0028; G.pitch = max(-170, min(170, G.pitch - my * .8))
        elif G.state == 'play': update_play(dt)
        elif G.state == 'end':
            G.timer -= dt
            if not SMOKE: pygame.mouse.get_rel()
            if G.timer <= 0:
                if G.over: G.state = 'over'
                else: new_round()
        frames += 1
        spec = (not p.alive) and G.state in ('play', 'end') and not SMOKE; cam = p
        if spec:
            G.z = G.jz = G.vz = G.crouch = 0; G.ads, G.tanh = 0, TANH
            mx, my = pygame.mouse.get_rel(); G.pitch = max(-170, min(170, G.pitch - my * .8))
            mates = [a for a in G.actors if a.team == p.team and a.alive]
            if G.cammode == 0 and not mates: G.cammode = 1
            if G.cammode == 0: G.vi %= len(mates); cam = mates[G.vi]
            elif G.cammode == 1:
                f = G.free; ks = pygame.key.get_pressed(); f.ang += mx * .0028
                fw, sd = ks[pygame.K_w] - ks[pygame.K_s], ks[pygame.K_d] - ks[pygame.K_a]; sp = 8 * dt
                try_move(f, (math.cos(f.ang) * fw - math.sin(f.ang) * sd) * sp, (math.sin(f.ang) * fw + math.cos(f.ang) * sd) * sp); cam = f
        elif not (G.state == 'play' and p.alive and not SMOKE): G.ads, G.tanh = 0, TANH
        G.lastcam = G.cam = cam
        if SMOKE and frames % 40 and frames > 30:
            if frames > 6000: print("SMOKE OK", G.score, G.state); return
            continue
        if spec and G.cammode == 2: draw_topdown()
        else:
            render(cam)
            if p.alive: viewmodel(p); scope(); draw_guide(p)
        hud(dt)
        if spec: txt(f"SPECTATING {cam.name if cam is not G.free else 'free cam'}   (LEFT/RIGHT switch camera, V change view)" if G.cammode != 2 else "TOP-DOWN VIEW   (V change view)", F, (255, 255, 255), W // 2, H - 100, True)
        if G.state == 'buy': buy_menu()
        if G.state in ('end', 'over'):
            txt(G.endmsg, FM, (255, 255, 255), W // 2, H // 2 - 20, True)
            if G.state == 'over':
                txt(("STINKERS" if G.score['A'] > G.score['D'] else "CLEANERS") + " WIN THE MATCH!  Press R", FB, (255, 220, 80), W // 2, H // 2 + 40, True)
        pygame.display.flip()
        if not SMOKE:
            ft.append(raw)
            if len(ft) >= 90:
                if sum(ft) / len(ft) > .027 and RES < 8: set_res(RES + 2)
                ft = []

if __name__ == "__main__": main()
