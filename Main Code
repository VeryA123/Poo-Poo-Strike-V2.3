def can_see(a, e):
    ex, ey = e.x + e.lx, e.y + e.ly; dx, dy = ex - a.x, ey - a.y
    if math.hypot(dx, dy) > 1.5 and abs(angdiff(a.ang, math.atan2(dy, dx))) > 1.25: return False
    return los(a.x, a.y, ex, ey)

def go(a, gx, gy, speed, dt):
    d = math.hypot(gx - a.x, gy - a.y)
    if d < .25: return d
    if d < 3 and los(a.x, a.y, gx, gy): tx, ty = gx, gy
    else: tx, ty = next_step(a.x, a.y, (int(gx), int(gy))) or (gx, gy)
    ang = math.atan2(ty - a.y, tx - a.x)
    try_move(a, math.cos(ang) * speed * dt, math.sin(ang) * speed * dt)
    turn(a, ang, 7, dt)
    return d

def combat(a, t, dt):
    sk = G.skill; tx, ty = t.x + t.lx, t.y + t.ly; dx, dy = tx - a.x, ty - a.y; d = math.hypot(dx, dy); ta = math.atan2(dy, dx)
    turn(a, ta, 11 * sk, dt); a.react -= dt; a.strafe_t -= dt
    if a.strafe_t <= 0: a.strafe, a.strafe_t = random.choice((-1, 1)), random.uniform(.3, .8)
    adv = a.team == 'A'                       # attackers push, defenders hold their angle
    fwd = -1 if a.hp < 35 else 1 if (a.w == 3 and d > 4) else .6 if (adv and a.w in (0, 1, 2, 5, 6, 7) and d > 10) else -.6 if d < 3 else 0
    moving = a.cd > .05                       # counter-strafe: stand still to take the shot
    vx = fwd * math.cos(ta) * 2.2 + (a.strafe * -math.sin(ta) * 2.6 if moving else 0)
    vy = fwd * math.sin(ta) * 2.2 + (a.strafe * math.cos(ta) * 2.6 if moving else 0)
    if not try_move(a, vx * dt, vy * dt): a.strafe *= -1
    if a.react <= 0 and abs(angdiff(a.ang, ta)) < .15: fire(a, (.010 + .0014 * d + (.015 if moving else 0)) / sk)

