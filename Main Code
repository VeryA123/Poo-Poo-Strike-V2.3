    m = [W // 2 + 40 - 37 * ads + 90 * sp, H // 2 + 100 - 60 * ads + kick * .4 + rl * .5 + eq * .5 + 90 * sp + air]
    L = math.hypot(m[0] - n[0], m[1] - n[1]) or 1; ux, uy = (m[0] - n[0]) / L, (m[1] - n[1]) / L; back = p.recoil * 26
