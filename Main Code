def bot_update(a, dt):
    a.cd -= dt; a.flash -= dt; a.planting = a.defusing = False; a.vis_t -= dt
    if a.blind > 0: a.blind -= dt; a.vis = []; a.target = None; return
    if a.throw_req and a.util.get('bubble'):
